        "hierarchies": [
          {
            "name": "Year-Week Hierarchy",
            "displayFolder": "Period",
            "levels": [
              {
                "name": "year",
                "column": "year",
                "lineageTag": "860ded76-a28d-4ca0-995e-d5d6da043395",
                "ordinal": 0
              },
              {
