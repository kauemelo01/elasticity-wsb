:{\"Expression\":{\"SourceRef\":{\"Source\":\"p\"}},\"Property\":\"lane_kma\"},\"Name\":\"Poisson.lane_kma\"}}]}},\"Output\":{\"Table\":{\"Name\":\"output0\",\"Columns\":[{\"Expression\":{\"Column\":{\"Expression\":{\"TransformTableRef\":{\"Source\":\"input0\"}},\"Property\":\"Poisson.lane_kma\"},\"Name\":\"Poisson.lane_kma\"}},{\"Role\":\"Series\",\"Expression\":{\"TransformOutputRoleRef\":{\"Role\":\"ClusterId\"},\"Name\":\"clusterId\"}}]}}}]},\"ItemIdColumns\":[\"Poisson.lane_kma\"],\"PartitionIdColumn\":\"clusterId\",\"Partitions\":[{\"DisplayName\":\"2. Semi Elastic\",\"PartitionIds\":[{\"Literal\":{\"Value\":\"1L\"}}]},{\"DisplayName\":\"3. Neutral\",\"PartitionIds\":[{\"Literal\":{\"Value\":\"2L\"}}]},{\"DisplayName\":\"5. True Inelastic\",\"PartitionIds\":[{\"Literal\":{\"Value\":\"3L\"}}]},{\"DisplayName\":\"1. True Elastic\",\"PartitionIds\":[{\"Literal\":{\"Value\":\"4L\"}}]},{\"DisplayName\":\"4. Semi Inelastic\",\"PartitionIds\":[{\"Literal\":{\"Value\":\"5L\"}}]},{\"PartitionIds\":[{\"Literal\":{\"Value\":\"null\"}}]}],\"DefaultPartitionPrefix\":\"Cluster\"},\"Result\":{\"TableName\":\"ClusterMappingTable\",\"PartitionIdColumn\":\"ClusterId\",\"ItemIdMappings\":[[{\"PartitionTableColumn\":{\"Column\":{\"Expression\":{\"SourceRef\":{\"Entity\":\"ClusterMappingTable\"}},\"Property\":\"lane_kma\"}},\"SourceTableColumn\":{\"Column\":{\"Expression\":{\"SourceRef\":{\"Entity\":\"Poisson\"}},\"Property\":\"lane_kma\"}}}]]}}}"
