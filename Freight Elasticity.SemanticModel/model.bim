          }
        ],
        "lineageTag": "fb852ff5-1705-435a-8366-a6e571a57092",
        "measures": [
          {
            "name": "RPM",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "displayFolder": "RPM",
            "expression": [
              "",
              "VAR D = DIVIDE(SUM('Loads (Main Set)'[bookings]),SUM('Loads (Main Set)'[mileage]))",
              "RETURN IF(D<1||D>30,BLANK(),D)"
            ],
            "formatString": "0.00",
            "lineageTag": "e6a29905-0df3-4eab-a0af-99e7e4a0ef17"
          },
          {
            "name": "Sourcing Spread Base %",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "displayFolder": "Sourcing Spreads",
            "expression": "DIVIDE(SUM('Loads (Main Set)'[Sourcing Spread Base]),SUM('Loads (Main Set)'[bookings]))",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "bed968c0-6180-4b34-b97a-2b754a8c7b6e"
          },
          {
            "name": "# Unique Shippers",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "displayFolder": "Unique Counts",
            "expression": "DISTINCTCOUNT('Loads (Main Set)'[shipper_name])",
            "formatString": "0",
            "lineageTag": "0f4e9c75-b192-4107-9534-5bec5bad86fd"
          },
          {
            "name": "Markup Over ECOH %",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "displayFolder": "ECOH",
            "expression": "CALCULATE(DIVIDE(SUM('Loads (Main Set)'[markup_ecoh]),SUM('Loads (Main Set)'[original_ecoh])),'Loads (Main Set)'[original_ecoh]>=300)",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "3c2b9cc3-f23d-4145-805d-e55bd5a39152"
          },
          {
            "name": "Conversion (KMA Level) %",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "displayFolder": "Conversion",
            "expression": "MIN(DIVIDE(SUM('Loads (Main Set)'[loads]),[# Quotes (KMA Level)]),1)",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "a002023c-9b26-4e3f-b616-1b41101673e6"
          },
          {
            "name": "Elasticity (raw)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "displayFolder": "Auxiliary Metrics",
            "expression": [
              "",
              "VAR T = VALUES('Loads (Main Set)'[year-week])",
              "VAR C = COUNTX(T,[Markup Over ECOH (wo ol) %]*[Conversion (KMA Level) %])",
              "RETURN IF(",
              "    C<[LPQ Threshold],",
              "    BLANK(),",
              "    VAR X  = SUMX(T,[Markup Over ECOH (wo ol) %])",
              "    VAR Y  = SUMX(T,[Conversion (KMA Level) %])",
              "    VAR XY = SUMX(T,[Markup Over ECOH (wo ol) %]*[Conversion (KMA Level) %])",
              "    VAR X2 = SUMX(T,[Markup Over ECOH (wo ol) %]^2)",
              "    VAR Y2 = SUMX(T,[Conversion (KMA Level) %]  ^2)",
              "    RETURN",
              "    DIVIDE(",
              "        C*XY-X*Y,",
              "        IFERROR(",
              "            SQRT((C*X2-X^2)*(C*Y2-Y^2)),",
              "            BLANK() // In case SQRT input is negative, disregard the output",
              "        )",
              "    )",
              ")"
            ],
            "lineageTag": "0245b044-8c1e-47c7-88c1-69fc82c65144"
          },
          {
            "name": "Markup Over ECOH (wo ol) %",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "displayFolder": "ECOH",
            "expression": [
              "",
              "VAR T = FILTER(",
              "    CALCULATETABLE(",
              "        SUMMARIZE(",
              "            'Loads (Main Set)',",
              "            'Loads (Main Set)'[year-week],",
              "            'Loads (Main Set)'[lane_kma],",
              "            \"X\",[Markup Over ECOH %]",
              "        ),",
              "        ALL('Loads (Main Set)')",
              "    ),",
              "\t[X]<>BLANK()",
              ")",
              "VAR Q1 = PERCENTILEX.INC(T,[X],.2)",
              "VAR Q4 = PERCENTILEX.INC(T,[X],.8)",
              "VAR LF = ROUND(Q1-(Q4-Q1)*1.25,2)",
              "VAR HF = ROUND(Q4+(Q4-Q1)*1.75,2)",
              "VAR D = [Markup Over ECOH %]",
              "RETURN IF(D<LF||D>HF,BLANK(),D)"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "66809a84-2654-4aa8-b3ff-3f727a6b2c09"
          },
          {
            "name": "Elasticity %",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              },
              {
                "name": "__PBI_SemanticLinks",
                "value": "[{\"LinkTarget\":{\"TableName\":\"Poisson\",\"TableItemName\":\"Poisson Clusters\",\"ObjectType\":4},\"LinkType\":\"UsedInGroup\"}]"
              }
            ],
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "displayFolder": "Elasticity",
            "expression": [
              "",
              "// Sigmoid normalization from -1 to +1",
              "VAR D = [Elasticity (raw)]",
              "RETURN IF(",
              "    ISBLANK(D),",
              "    BLANK(),",
              "    1-2/(1+EXP(D))",
              ")"
            ],
            "lineageTag": "afa38a81-0117-44a4-ac7b-c7b661fec567"
          },
          {
            "name": "Conversion (Lane Level) %",
            "displayFolder": "Conversion",
            "expression": "MIN(DIVIDE(SUM('Loads (Main Set)'[loads]),[# Quotes (Lane Level)]),1)",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "ba4e0cf4-407b-4208-a759-dacd450c631b"
          },
          {
            "name": "# Unique Carriers",
            "displayFolder": "Unique Counts",
            "expression": "ROUNDUP(DIVIDE(DISTINCTCOUNT('Loads (Main Set)'[sk_carrier]),[# Weeks]),0)",
            "formatString": "0",
            "lineageTag": "6f851d6b-ce99-41f7-adba-d123d9d1908f"
          },
          {
            "name": "# Unique KMA Lanes",
            "displayFolder": "Unique Counts",
            "expression": "DISTINCTCOUNT('Loads (Main Set)'[lane_kma])",
            "formatString": "0",
            "lineageTag": "c968cdce-0ec1-4f64-abeb-26d437d4ab1d"
          },
          {
            "name": "# Unique Lanes",
            "displayFolder": "Unique Counts",
            "expression": "DISTINCTCOUNT('Loads (Main Set)'[lane])",
            "formatString": "0",
            "lineageTag": "e2572fd2-ae2e-412c-a6f9-40901db5cd42"
          },
          {
            "name": "Elasticity % SRCC",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "Elasticity",
            "expression": [
              "",
              "VAR T = ADDCOLUMNS(",
              "    VALUES('Loads (Main Set)'[year-week]),",
              "    \"X\",[Markup Over ECOH (wo ol) %],",
              "    \"Y\",[Conversion (KMA Level) %],",
              "    \"C\",[Markup Over ECOH (wo ol) %]*[Conversion (KMA Level) %]",
              ")",
              "VAR C = COUNTX(T,[C])         // Counts # of non-zero rows",
              "RETURN IF(",
              "    C<[LPQ Threshold],",
              "    BLANK(),",
              "    VAR D = ADDCOLUMNS(T,\"D\",",
              "        RANKX(T,[X],,DESC,Dense)-",
              "        RANKX(T,[Y],,DESC,Dense)",
              "    )",
              "    VAR N = COUNTROWS(T)      // Counts # of all rows",
              "    VAR LF = [ZDT Fence]      // Quartile dif. of distances",
              "    VAR SF = MAX(LF/10,5)     // A tenth of the quartile dif. of distances, and not lower than 5 (and not higher than .2)",
              "    RETURN",
              "    1-6*SUMX(D,[D]^2)/(N^3-N) // Spearman Rank Correlation Coefficient formula",
              "    -MIN((N-C)/LF,1/SF)       // Zero-Deflation term: All Rows, minus Non-Zero Rows, qty. over Long Fence, and not higher than Short Fence",
              ")"
            ],
            "lineageTag": "877229df-479b-4d24-872e-3c0c0be8610c"
          },
          {
            "name": "ZDT Fence",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "Auxiliary Metrics",
            "expression": [
              "",
              "VAR T = ADDCOLUMNS(",
              "    CALCULATETABLE(",
              "        VALUES('Loads (Main Set)'[year-week]),",
              "        ALL('Loads (Main Set)')",
              "    ),",
              "    \"X\",CALCULATE(",
              "        [Markup Over ECOH (wo ol) %],",
              "        ALLEXCEPT(",
              "            'Loads (Main Set)',",
              "            'Loads (Main Set)'[year-week]",
              "        )",
              "    ),",
              "    \"Y\",CALCULATE(",
              "        [Conversion (KMA Level) %],",
              "        ALLEXCEPT(",
              "            'Loads (Main Set)',",
              "            'Loads (Main Set)'[year-week]",
              "        )",
              "    )",
              ")",
              "VAR D = ADDCOLUMNS(T,\"D\",",
              "\tRANKX(T,[X],,DESC,Dense)-",
              "\tRANKX(T,[Y],,DESC,Dense)",
              ")",
              "RETURN",
              "    PERCENTILEX.INC(D,[D],.75)-",
              "    PERCENTILEX.INC(D,[D],.25)"
            ],
            "lineageTag": "3732038f-1053-41ee-9f6c-20bddd13c026"
          },
          {
            "name": "LPQ Threshold",
            "displayFolder": "Auxiliary Metrics",
            "expression": [
              "",
              "ROUND(",
              "    COUNTROWS(",
              "        CALCULATETABLE(",
              "            VALUES('Loads (Main Set)'[year-week]),",
              "            ALL('Loads (Main Set)')",
              "        )",
              "    )/10,",
              "    0",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "a5b9f572-587b-40fb-b603-63f4d28f953f"
          },
          {
            "name": "Avg. LPW",
            "displayFolder": "# Loads",
            "expression": "DIVIDE(SUM('Loads (Main Set)'[loads]),[# Weeks])",
            "formatString": "0.0",
            "lineageTag": "ed1d695c-b663-4f95-a4b1-47d213aaf544"
          },
          {
            "name": "# Weeks",
            "displayFolder": "Unique Counts",
            "expression": "DISTINCTCOUNT('Loads (Main Set)'[year-week])",
            "formatString": "0",
            "lineageTag": "438f9faf-601a-42f5-b774-94d578e48e24"
          },
          {
            "name": "Elasticity % KTC",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "Elasticity",
            "expression": [
              "",
              "VAR T = VALUES('Loads (Main Set)'[year-week])",
              "RETURN IF(",
              "    COUNTX(T,[Markup Over ECOH (wo ol) %]*[Conversion (KMA Level) %])<[LPQ Threshold],",
              "    BLANK(),",
              "    DIVIDE(",
              "        SUMX(T,",
              "            VAR X = RANKX(T,[Markup Over ECOH (wo ol) %],,DESC,Dense)",
              "            VAR Y = RANKX(T,[Conversion (KMA Level) %],,DESC,Dense)",
              "            RETURN COUNTROWS(",
              "                FILTER(T,",
              "                    RANKX(T,[Markup Over ECOH (wo ol) %],,DESC,Dense) <X",
              "                    && RANKX(T,[Conversion (KMA Level) %],,DESC,Dense)<Y",
              "                )",
              "            )",
              "        )-SUMX(T,",
              "            VAR X = RANKX(T,[Markup Over ECOH (wo ol) %],,DESC,Dense)",
              "            VAR Y = RANKX(T,[Conversion (KMA Level) %],,DESC,Dense)",
              "            RETURN COUNTROWS(",
              "                FILTER(T,",
              "                    RANKX(T,[Markup Over ECOH (wo ol) %],,DESC,Dense) <X",
              "                    && RANKX(T,[Conversion (KMA Level) %],,DESC,Dense)>Y",
              "                )",
              "            )",
              "        ),",
              "        COMBIN(COUNTROWS(T),2)",
              "    )",
              ")"
            ],
            "lineageTag": "7bfee349-6c24-474e-922b-3fe373bd16ce"
          },
          {
            "name": "ξ Correl. %",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "Elasticity",
            "expression": [
              "",
              "VAR T = VALUES('Loads (Main Set)'[year-week])",
              "RETURN IF(",
              "    COUNTX(T,[Markup Over ECOH (wo ol) %]*[Conversion (KMA Level) %])<[LPQ Threshold],",
              "    BLANK(),",
              "    VAR N = COUNTROWS(T)",
              "    VAR D = SUMX(",
              "        ADDCOLUMNS(T,",
              "            \"Ri\",RANKX(T,[Conversion (KMA Level) %]),   ",
              "            \"Ri+1\",CALCULATE(",
              "                RANKX(T,[Conversion (KMA Level) %]),",
              "                FILTER(T,",
              "                    [year-week]=EARLIER([year-week])+1",
              "                )",
              "            )",
              "        ),",
              "        ABS([Ri+1]-[Ri])",
              "    )",
              "    VAR L = SUMX(T,",
              "        VAR X = [Markup Over ECOH (wo ol) %]",
              "        VAR LX = COUNTROWS(",
              "            FILTER(T,",
              "                [Markup Over ECOH (wo ol) %]>=X",
              "            )",
              "        )",
              "        RETURN LX*(N-LX)",
              "    )",
              "    RETURN 1-2/(1+EXP( // Sigmoid normalization from -1 to +1",
              "        1-(N*D)/(2*L)) // ξ Correl. formula ",
              "    )",
              ")"
            ],
            "lineageTag": "776c76eb-f039-4522-9cfc-9714a5ec8ba5"
          },
          {
            "name": "# Quotes (Lane Level)",
            "displayFolder": "# Quotes",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM(Quotes[quotes]),",
              "    USERELATIONSHIP(",
              "        'Loads (Main Set)'[Lane Key],",
              "        Quotes[lane_key]",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "32b1780d-2b90-473e-a660-cd299c7554f1"
          },
          {
            "name": "# Quotes (KMA Level)",
            "displayFolder": "# Quotes",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM(Quotes[quotes]),",
              "    USERELATIONSHIP(",
              "        'Loads (Main Set)'[KMA Key],",
              "        Quotes[kma_key]",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "d2e32dee-176e-4dfe-a20c-15c5da383237"
          },
          {
            "name": "WSB",
            "displayFolder": "WSB",
            "expression": [
              "",
              "IF(DISTINCTCOUNT('Loads (Main Set)'[lane_kma])>1 || ISBLANK(SUM('Loads (Main Set)'[loads])),",
              "    BLANK(),",
              "    IF(SUM('Loads (Main Set)'[loads])>12,",
              "        IF([# Unique Shippers]>2,",
              "            \"WINDOW\",",
              "            \"SHADOW\"",
              "        ),",
              "        IF([# Unique Shippers]>2,",
              "            \"SHADOW\",",
              "            \"BLIND\"",
              "        )",
              "    )",
              ")"
            ],
            "lineageTag": "6731b3ad-8cd8-4ece-a52e-ee60d8a1e546"
          },
          {
            "name": "Elasticity Clusters",
            "displayFolder": "Clusters",
            "expression": [
              "",
              "VAR D1 = [Elasticity %]",
              "VAR D2 = [Elasticity % SRCC]",
              "VAR NT = [NC Threshold]",
              "RETURN",
              "IF(ISBLANK(D1) && ISBLANK(D2),BLANK(),",
              "    IF(ABS(D1)<NT && ABS(D2)<NT,\"3. Neutral\",",
              "    IF(D1<0 && D2<0,\"1. True Elastic\",",
              "    IF(D1>0 && D2>0,\"5. True Inelastic\",",
              "    IF(D1<0 && D2>0,\"2. Semi Elastic\",",
              "    \"4. Semi Inelastic\"",
              "    ))))",
              ")"
            ],
            "lineageTag": "440cb37f-d7f5-477e-83a5-1a3e884bbd5a"
          },
          {
            "name": "# Unique Cluster Keys",
            "displayFolder": "Unique Counts",
            "expression": "DISTINCTCOUNT('Loads (Main Set)'[Cluster Key])",
            "formatString": "0",
            "lineageTag": "fb827a3e-6bd9-4dbc-9682-da5b8dc35ef0"
          },
          {
            "name": "NC Threshold",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "Auxiliary Metrics",
            "expression": [
              "",
              "-MEDIANX(",
              "    FILTER(",
              "        CALCULATETABLE(",
              "            ADDCOLUMNS(",
