        "partitions": [
          {
            "name": "dim_lane_activity",
            "mode": "import",
            "source": {
              "expression": [
                "",
                "ADDCOLUMNS(",
                "    VALUES('Loads (Main Set)'[Activity Key]),",
                "    \"Is active in 2023? (Y/N)\",",
                "        IF(CALCULATE(SUM('Loads (Main Set)'[loads]),'Loads (Main Set)'[year]=2023),\"Y\",\"N\"),",
                "    \"Is active in 2024? (Y/N)\",",
                "        IF(CALCULATE(SUM('Loads (Main Set)'[loads]),'Loads (Main Set)'[year]=2024),\"Y\",\"N\")",
                "    )"
              ],
              "type": "calculated"
            }
          }
        ]
      },
