              "        [X]<>BLANK()",
              "    ),",
              "    [X]",
              ")"
            ],
            "lineageTag": "0809dadf-cfe7-4b68-aa18-3b0492efd2a6"
          },
          {
            "name": "Market Intel A P99",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "Auxiliary Metrics",
            "expression": "CALCULATE(PERCENTILE.INC('Market Intel A Volumes'[volume],.99),ALL('Loads (Main Set)'))",
            "lineageTag": "f8a19546-556f-4f15-b1a2-dbaf67bfafef"
          },
          {
            "name": "Market Position",
            "displayFolder": "WSB",
            "expression": [
              "",
              "VAR WSB_LS = SWITCH([WSB]        ,\"WINDOW\",3,\"SHADOW\",2,\"BLIND\",1,BLANK())",
              "VAR WSB_S  = SWITCH([WSB (Market Intel A)],\"WINDOW\",3,\"SHADOW\",2,\"BLIND\",1,BLANK())",
              "RETURN",
              "IF(ISBLANK(WSB_LS) && NOT(ISBLANK(WSB_S)),\"Not participating\",",
              "IF(ISBLANK(WSB_S) && NOT(ISBLANK(WSB_LS)),BLANK(),",
              "IF(WSB_LS=WSB_S,\"At Market\",",
              "IF(WSB_LS>WSB_S,\"Ahead Of Market\",",
              "\"Behind Market\"))))"
            ],
            "lineageTag": "6bd6df9a-b82c-4ff5-ac0f-30cf928b8e62"
          },
          {
