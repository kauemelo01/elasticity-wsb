                "    Source = Parquet.Document(File.Contents(DataFolder & \"Market Intel B Volumes.parquet\")),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source, {{\"omast_kma\", type text}, {\"dmast_kma\", type text}, {\"rate_type\", type text}, {\"equip_type\", type text}, {\"shippers\", Int64.Type}, {\"volumes\", Int64.Type}})",
                "in",
                "    #\"Changed Type\""
              ],
              "type": "m"
            }
          }
        ]
