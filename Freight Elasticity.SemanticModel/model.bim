        "lineageTag": "feb3daf9-3dbe-45f2-b7ef-1fd9d08ce64a",
        "measures": [
          {
            "name": "WSB (Market Intel B)",
            "displayFolder": "WSB",
            "expression": [
              "",
              "VAR SV = SUM('Market Intel B Volumes'[shippers])",
              "VAR VV = SUM('Market Intel B Volumes'[volumes])",
              "VAR ST = [Market Intel B P90]",
              "VAR VT = [Market Intel B P75]",
              "RETURN",
              "IF(ISBLANK(VV) || DISTINCTCOUNT('Loads (Main Set)'[lane_kma])>1,",
              "    BLANK(),",
              "    IF(VV>VT,",
              "        IF(SV>ST,",
              "            \"WINDOW\",",
              "            \"SHADOW\"",
              "        ),",
              "        IF(SV>ST,",
              "            \"SHADOW\",",
              "            \"BLIND\"",
              "        )",
              "    )",
              ")"
            ],
            "lineageTag": "2f0ee4a4-7818-41e5-bbac-20345932aa52"
          }
        ],
        "partitions": [
