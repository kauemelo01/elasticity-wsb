        ],
        "isHidden": true,
        "isPrivate": true,
        "lineageTag": "39d80de4-6a54-4c55-88d5-df33a8e8451e",
        "partitions": [
          {
            "name": "ClusterMappingTable",
            "mode": "import",
            "source": {
              "expression": [
                "VAR __DS0FilterTable = ",
                "\tFILTER(",
                "\t\tKEEPFILTERS(VALUES('dim_lane'[origin_kma])),",
                "\t\tNOT('dim_lane'[origin_kma] IN {BLANK()})",
                "\t)",
                "",
                "VAR __DS0FilterTable2 = ",
                "\tFILTER(",
                "\t\tKEEPFILTERS(VALUES('dim_lane'[destiny_kma])),",
                "\t\tNOT('dim_lane'[destiny_kma] IN {BLANK()})",
                "\t)",
                "",
                "VAR __DS0Core = ",
                "\tSUMMARIZECOLUMNS(",
                "\t\t'Poisson'[lane_kma],",
                "\t\t__DS0FilterTable,",
                "\t\t__DS0FilterTable2,",
                "\t\t\"Elasticity__\", 'Loads (Main Set)'[Elasticity %],",
                "\t\t\"Poisson__\", 'Poisson'[Poisson %],",
                "\t\t\"Sumloads\", CALCULATE(SUM('Loads (Main Set)'[loads]))",
                "\t)",
                "",
                "VAR __DataTransformT0 = ",
                "\tKMeansClustering(",
                "\t\tSELECTCOLUMNS(",
                "\t\t\t__DS0Core,",
                "\t\t\t\"lane_kma\", 'Poisson'[lane_kma],",
                "\t\t\t\"Elasticity__\", [Elasticity__],",
                "\t\t\t\"Poisson__\", [Poisson__],",
                "\t\t\t\"Sumloads\", [Sumloads]",
                "\t\t),",
                "\t\t{(\"[Elasticity__]\", \"Attribute\"),",
                "\t\t\t(\"[Poisson__]\", \"Attribute\"),",
                "\t\t\t(\"[Sumloads]\", \"Attribute\"),",
                "\t\t\t(\"[lane_kma]\", \"Item\")},",
                "\t\t{(\"[lane_kma]\", BLANK()),",
                "\t\t\t(\"ClusterId\", \"ClusterId\")},",
                "\t\t5",
                "\t)",
                "",
                "RETURN __DataTransformT0"
              ],
              "retainDataTillForceCalculate": true,
              "type": "calculated"
            }
          }
        ]
      }
